<div class="pay-options" id="pay-options" style="display:none;">
        <label class="pay-opt" data-pay="paid"><input type="radio" name="pay" value="paid" checked> تەواو پارەدراوە</label>
        <label class="pay-opt" data-pay="partial"><input type="radio" name="pay" value="partial"> بەشێکی پارەدراوە</label>
        <label class="pay-opt" data-pay="credit"><input type="radio" name="pay" value="credit"> بە قەرز (هیچ پارەیەک ئێستا نەدراوە)</label>
      </div>
      <div class="field" id="partial-amount-field" style="display:none;">
        <label>بڕی پارەی دراو ئێستا (د.ع)</label>
        <input type="number" id="bill-partial-amount" min="0" placeholder="0">
      </div>

      <button class="btn" id="btn-checkout" style="width:100%;margin-top:14px;" disabled>تەواوکردنی فرۆشتن</button>
    </div>
  </div>
</section>

<!-- HISTORY -->
<section class="view" id="view-history">
  <div class="page-head">
    <p class="page-title">مێژووی فرۆشتن</p>
    <p class="page-sub">فرۆشتنە پێشووەکان، نوێترین یەکەم.</p>
  </div>
  <div class="panel">
    <div id="history-list"></div>
    <div class="empty-note" id="history-empty" style="display:none;">هیچ فرۆشتنێک تۆمار نەکراوە.</div>
  </div>
</section>

<!-- CLIENTS -->
<section class="view" id="view-clients">
  <div class="page-head">
    <p class="page-title">کڕیارەکان</p>
    <p class="page-sub">لیستی دەرمانخانەکانی کڕیار.</p>
  </div>
  <div class="toolbar">
    <input type="text" class="search-input" id="client-search" placeholder="گەڕان بە ناوی دەرمانخانە">
    <button class="btn" id="btn-add-client">+ زیادکردنی کڕیار</button>
  </div>
  <div class="panel" style="padding:0;overflow-x:auto;">
    <table>
      <thead><tr><th>ناوی دەرمانخانە</th><th>ژمارەی مۆبایل</th><th>ناونیشان</th><th>قەرزی ماوە</th><th></th></tr></thead>
      <tbody id="client-tbody"></tbody>
    </table>
    <div class="empty-note" id="client-empty" style="display:none;">هیچ کڕیارێک زیاد نەکراوە.</div>
  </div>
</section>

<!-- DEBTS -->
<section class="view" id="view-debts">
  <div class="page-head">
    <p class="page-title">قەرزەکان</p>
    <p class="page-sub">قەرزی هەموو دەرمانخانە کڕیارەکان.</p>
  </div>
  <div class="panel" style="padding:0;overflow-x:auto;">
    <table>
      <thead><tr><th>کڕیار</th><th>کۆی قەرز</th><th></th></tr></thead>
      <tbody id="debt-tbody"></tbody>
    </table>
    <div class="empty-note" id="debt-empty" style="display:none;">هیچ کڕیارێک قەرزی نیە.</div>
  </div>
</section>
