icon-btn{background:none;border:1px solid var(--line);border-radius:6px;padding:5px 8px;cursor:pointer;color:var(--text-soft);font-size:12px;font-family:inherit;} .icon-btn:hover{border-color:var(--pine);color:var(--pine);} .icon-btn.del:hover{border-color:var(--danger);color:var(--danger);}
.billing-grid{display:grid;grid-template-columns:1.4fr 1fr;gap:18px;align-items:start;} @media (max-width:820px){.billing-grid{grid-template-columns:1fr;}} .med-pick{display:flex;justify-content:space-between;align-items:center;padding:10px 12px;border:1px solid var(--line);border-radius:8px;margin-bottom:8px;} .med-pick .mp-name{font-weight:600;font-size:13px;} .med-pick .mp-meta{font-size:11.5px;color:var(--text-soft);} .cart-item{display:flex;justify-content:space-between;align-items:center;padding:9px 0;border-bottom:1px solid var(--line);font-size:13px;} .cart-item:last-child{border-bottom:none;} .qty-controls{display:flex;align-items:center;gap:6px;} .qty-controls button{width:24px;height:24px;border-radius:6px;border:1px solid var(--line);background:#fff;cursor:pointer;font-family:inherit;} .cart-total-row{display:flex;justify-content:space-between;padding-top:12px;margin-top:8px;border-top:2px solid var(--pine-dark);font-weight:600;font-size:15px;} .pay-options{display:flex;flex-direction:column;gap:8px;margin:12px 0;} .pay-opt{display:flex;align-items:center;gap:8px;padding:8px 10px;border:1px solid var(--line);border-radius:8px;font-size:13px;cursor:pointer;} .pay-opt input{margin:0;} .pay-opt.active{border-color:var(--pine);background:var(--mint);}
.modal-overlay{position:fixed;inset:0;background:rgba(15,51,44,.45);display:none;align-items:center;justify-content:center;z-index:50;padding:20px;} .modal-overlay.open{display:flex;} .modal{background:#fff;border-radius:var(--radius);padding:22px 24px;width:100%;max-width:440px;max-height:90vh;overflow-y:auto;} .modal h3{margin:0 0 16px;font-size:16px;} .field{margin-bottom:12px;} .field label{display:block;font-size:12px;color:var(--text-soft);margin-bottom:5px;font-weight:500;} .field input, .field select{width:100%;padding:9px 10px;border:1px solid var(--line);border-radius:7px;font-family:inherit;font-size:13px;} .field input:focus, .field select:focus{outline:2px solid var(--pine);outline-offset:-1px;} .field-row{display:grid;grid-template-columns:1fr 1fr;gap:10px;} .modal-actions{display:flex;justify-content:flex-start;gap:8px;margin-top:18px;}
.toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:var(--pine-dark);color:#fff;padding:10px 18px;border-radius:8px;font-size:13px;z-index:60;display:none;} .toast.show{display:block;} .sync-dot{display:inline-flex;align-items:center;gap:6px;font-size:11px;color:#82998F;} .sync-dot .d{width:7px;height:7px;border-radius:50%;background:#4C9A7A;} .sync-dot .d.busy{background:var(--amber);}
.history-entry{border:1px solid var(--line);border-radius:8px;margin-bottom:10px;overflow:hidden;} .history-head{display:flex;justify-content:space-between;align-items:center;padding:12px 14px;cursor:pointer;background:#fafcfb;gap:10px;} .history-body{padding:0 14px 14px;display:none;font-size:12.5px;} .history-body.open{display:block;} .history-line{display:flex;justify-content:space-between;padding:4px 0;color:var(--text-soft);}
::-webkit-scrollbar{width:8px;height:8px;} ::-webkit-scrollbar-thumb{background:var(--line);border-radius:8px;}
#boot-loading{position:fixed;inset:0;background:var(--bg);display:flex;align-items:center;justify-content:center;flex-direction:column;gap:14px;z-index:200;transition:opacity .25s ease;} .spinner{width:30px;height:30px;border:3px solid var(--line);border-top-color:var(--pine);border-radius:50%;animation:spin .7s linear infinite;} @keyframes spin{to{transform:rotate(360deg);}} #boot-loading .boot-text{font-size:13px;color:var(--text-soft);}
.storage-banner{display:none;background:var(--amber-bg);border:1px solid var(--amber);color:#7a5a1e;border-radius:8px;padding:10px 14px;font-size:12.5px;margin-bottom:16px;line-height:1.6;} .storage-banner.show{display:block;}
