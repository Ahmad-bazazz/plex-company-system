.sidebar{ width:230px;flex-shrink:0;background:var(--pine-dark);color:#fff; display:flex;flex-direction:column;padding:24px 14px;position:sticky;top:0;height:100vh; } .brand{display:flex;align-items:center;gap:10px;padding:0 8px 22px 8px;border-bottom:1px solid rgba(255,255,255,.12);margin-bottom:18px;} .brand-mark{width:32px;height:32px;border-radius:8px;background:var(--mint);display:flex;align-items:center;justify-content:center;flex-shrink:0;} .brand-mark svg{width:17px;height:17px;} .brand-name{font-weight:600;font-size:15px;line-height:1.3;} .brand-sub{font-size:11px;color:#9FBDB2;line-height:1.4;} nav{display:flex;flex-direction:column;gap:4px;} .nav-btn{ display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:8px;border:none; background:transparent;color:#C9DBD4;font-size:14px;font-family:inherit;cursor:pointer;text-align:right;width:100%; } .nav-btn svg{width:17px;height:17px;flex-shrink:0;} .nav-btn:hover{background:rgba(255,255,255,.06);color:#fff;} .nav-btn.active{background:var(--mint);color:var(--pine-dark);font-weight:600;} .sidebar-foot{margin-top:auto;font-size:11px;color:#82998F;padding:0 8px;line-height:1.5;}
.main{flex:1;min-width:0;padding:28px 32px 60px;max-width:1180px;} .page-head{margin-bottom:22px;} .page-title{font-size:22px;font-weight:600;margin:0 0 4px;} .page-sub{font-size:13px;color:var(--text-soft);margin:0;} .view{display:none;} .view.active{display:block;}
.stat-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:14px;margin-bottom:24px;} .stat-card{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:16px 18px;} .stat-card .label{font-size:12px;color:var(--text-soft);margin-bottom:8px;} .stat-card .value{font-size:24px;font-weight:600;font-family:'IBM Plex Mono',monospace;direction:ltr;} .stat-card.warn .value{color:var(--amber);} .stat-card.bad .value{color:var(--danger);}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:18px 20px;margin-bottom:18px;} .panel-title{font-size:14px;font-weight:600;margin:0 0 12px;} .empty-note{font-size:13px;color:var(--text-soft);padding:14px 0;}
.toolbar{display:flex;gap:10px;align-items:center;margin-bottom:16px;flex-wrap:wrap;} .search-input{ flex:1;min-width:180px;padding:9px 12px;border:1px solid var(--line);border-radius:8px; font-family:inherit;font-size:13px;background:#fff; } .search-input:focus{outline:2px solid var(--pine);outline-offset:-1px;} .btn{ padding:9px 16px;border-radius:8px;border:1px solid var(--pine);background:var(--pine);color:#fff; font-family:inherit;font-size:13px;font-weight:500;cursor:pointer;white-space:nowrap; } .btn:hover{background:var(--pine-dark);} .btn.secondary{background:#fff;color:var(--pine);} .btn.secondary:hover{background:var(--mint);} .btn.ghost{background:transparent;border-color:var(--line);color:var(--text-soft);} .btn.ghost:hover{border-color:var(--pine);color:var(--pine);} .btn.danger{background:#fff;border-color:var(--danger);color:var(--danger);} .btn.danger:hover{background:var(--danger-bg);} .btn:disabled{opacity:.45;cursor:not-allowed;} .btn.small{padding:6px 11px;font-size:12px;}
table{width:100%;border-collapse:collapse;font-size:13px;} th{text-align:right;font-weight:600;color:var(--text-soft);font-size:11.5px;padding:8px 10px;border-bottom:1px solid var(--line);} td{padding:10px 10px;border-bottom:1px solid var(--line);vertical-align:middle;} tr:last-child td{border-bottom:none;} tr.row-bad td{background:var(--danger-bg);} tr.row-warn td{background:var(--amber-bg);} .tag{display:inline-block;padding:2px 8px;border-radius:20px;font-size:11px;font-weight:600;} .tag.ok{background:var(--mint);color:var(--pine-dark);} .tag.warn{background:var(--amber-bg);color:var(--amber);border:1px solid var(--amber);} .tag.bad{background:var(--danger-bg);color:var(--danger);border:1px solid var(--danger);} .row-actions{display:flex;gap:6px;} .
