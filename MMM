<!-- DASHBOARD -->
<section class="view active" id="view-dashboard">
  <div class="page-head">
    <p class="page-title">داشبۆرد</p>
    <p class="page-sub">ڕوانگەیەکی خێرا بۆ کۆگا و فرۆشتنەکانت.</p>
  </div>
  <div class="storage-banner" id="storage-banner"></div>
  <div class="stat-grid" id="stat-grid"></div>
  <div class="panel">
    <p class="panel-title">پێویستی سەرنجدانە</p>
    <div id="attention-list"></div>
  </div>
  <div class="panel">
    <p class="panel-title">فرۆشتنە دواییەکان</p>
    <div id="recent-sales"></div>
  </div>
  <div class="panel">
    <p class="panel-title">پاشەکەوتکردنی داتا</p>
    <div class="backup-row">
      <button class="btn secondary small" id="btn-export">داگرتنی کۆپی</button>
      <button class="btn ghost small" id="btn-import-trigger">گەڕاندنەوەی کۆپی</button>
      <button class="btn ghost small" id="btn-refresh" style="display:none;">نوێکردنەوە</button>
      <input type="file" id="import-file-input" accept="application/json" style="display:none;">
    </div>
    <p class="backup-note">داگرتنی کۆپییەک لە داتاکانت وەک فایل، بۆ پاراستنی لە هەر شوێنێکی جیاواز.</p>
  </div>
</section>

<!-- INVENTORY -->
<section class="view" id="view-inventory">
  <div class="page-head">
    <p class="page-title">کۆگا</p>
    <p class="page-sub">هەموو دەرمان و کاڵاکانی ئێستا لە کۆگادا.</p>
  </div>
  <div class="toolbar">
    <input type="text" class="search-input" id="inv-search" placeholder="گەڕان بە ناو، جۆر یان ژمارەی بەچ">
    <button class="btn" id="btn-add-medicine">+ زیادکردنی دەرمان</button>
  </div>
  <div class="panel" style="padding:0;overflow-x:auto;">
    <table id="inv-table">
      <thead>
        <tr>
          <th>ناو</th><th>جۆر</th><th>بەچ</th><th>کۆگا</th><th>نرخ</th><th>بەسەرچوون</th><th>دۆخ</th><th></th>
        </tr>
      </thead>
      <tbody id="inv-tbody"></tbody>
    </table>
    <div class="empty-note" id="inv-empty" style="display:none;">هیچ دەرمانێک نیە. یەکەم دەرمان زیاد بکە بۆ دەستپێکردن.</div>
  </div>
</section>

